# Copy to .env. Keys stay on the backend and must never be committed.
LLM_API_KEY=
# openai or alibaba (Qwen3.7-Flash); demo mode overrides either.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
# Demo mode returns a fixed template, not LLM-generated content.
DEMO_MODE=false
# IMAGE_PROVIDER=mock makes clearly labeled, local placeholder images.
IMAGE_PROVIDER=mock
# For OpenAI Images use IMAGE_PROVIDER=openai; for Qwen-Image 3.0 use alibaba.
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_TIMEOUT_SECONDS=180
# Generated files are local and ignored by Git.
ASSET_DIR=data/assets
